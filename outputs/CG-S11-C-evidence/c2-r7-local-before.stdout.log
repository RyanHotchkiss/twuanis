{"data": [{"source_name": "House", "source_slug": null, "source_type": "property_type", "target_name": "Boat Access Only", "target_slug": null, "target_type": "accessibility", "source_term_id": 1, "target_term_id": 1176, "relationship_type": "test_relation"}], "definition": " SELECT r.source_term_id,\n    r.target_term_id,\n    r.relationship_type,\n    source.term_name AS source_name,\n    source.term_type AS source_type,\n    source.slug AS source_slug,\n    target.term_name AS target_name,\n    target.term_type AS target_type,\n    target.slug AS target_slug\n   FROM ontology_relationships r\n     JOIN ontology_terms source ON source.id = r.source_term_id\n     JOIN ontology_terms target ON target.id = r.target_term_id;"}
